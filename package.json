    "workspace:doctor": "node scripts/workspace.mjs doctor",
    "workspace:check": "node scripts/workspace.mjs verify core --task check",
    "workspace:build": "node scripts/workspace.mjs verify core --task build",
    "workspace:install": "node scripts/workspace.mjs install core",
    "stack": "node scripts/stack.mjs",
    "stack:check": "node scripts/stack.mjs check",
    "test": "node --test scripts/*.test.mjs",
    "gateway:build": "npm --prefix gateway run build",
    "gateway:start": "npm --prefix gateway start",
    "router:start": "npm --prefix clawdrouter start",
    "router:test": "npm --prefix clawdrouter test"
