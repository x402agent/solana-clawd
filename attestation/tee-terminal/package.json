{
  "name": "@openclawdsolana/tee-terminal",
  "version": "0.1.0",
  "description": "TEE-style encrypted terminal with Solana attestation and private AI routing",
  "main": "dist/server.js",
  "bin": {
    "clawd-tee": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "dev:server": "tsx src/server.ts",
    "dev:cli": "tsx src/cli.ts",
    "start": "tsx src/server.ts",
    "cli": "tsx src/cli.ts",
    "test": "tsx --test test/neon-infer.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "npm run build && node --test tests/*.test.cjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.36.3",
    "@solana/kit": "^2.1.1",
    "dotenv": "^16.4.7",
    "uuid": "^11.1.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.5.13",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  }
}
