        "check": "typecheck",
        "build": "build"
      }
    },
    {
      "id": "mcp",
      "path": "mcp",
      "category": "core",
      "purpose": "MCP stdio and HTTP tool server",
      "required": true,
      "manifests": [
        "package.json",
        "tsconfig.json"
      ],
      "toolchain": [
        "node",
        "npm"
      ],
      "buildAfter": [
        "sdk",
        "router",
        "leviathan"
      ],
      "tasks": {
        "check": "typecheck",
        "build": "build"
      },
      "runtime": {
        "port": 3001,
        "environment": [
          "MCP_PORT",
          "MCP_HOST",
          "GATEWAY_URL",
          "CLAWD_GATEWAY_URL"
        ],
        "connectsTo": [
          "gateway",
          "router",
          "leviathan"
        ],
        "notes": "HTTP and stdio are separate transports. Configure external providers before invoking their tools.",
        "health": "/health",
        "transports": [
          "/mcp",
          "/sse"
        ]
      }
    },
    {
      "id": "gateway",
      "path": "gateway",
