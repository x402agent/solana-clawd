        "environment": [
          "GATEWAY_PORT",
          "GATEWAY_HOST",
          "GATEWAY_BACKGROUND_ENABLED",
          "SOLANA_RPC_URL",
          "HELIUS_API_KEY",
          "BIRDEYE_API_KEY"
        ],
        "connectsTo": [],
        "notes": "MCP can consume this HTTP service. Background Telegram and Birdeye jobs are opt-in with GATEWAY_BACKGROUND_ENABLED=true.",
