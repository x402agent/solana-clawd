        "build": "build"
      }
    },
    {
      "id": "router",
      "path": "clawdrouter",
      "category": "core",
      "purpose": "Model routing library and optional funded router service",
      "required": true,
      "manifests": [
        "package.json",
        "tsconfig.json"
      ],
      "toolchain": [
        "node",
        "npm"
      ],
      "buildAfter": [
        "sdk"
      ],
      "tasks": {
        "check": "typecheck",
        "build": "build"
      },
      "runtime": {
        "environment": [
          "CLAWDROUTER_PORT",
          "OPENROUTER_API_KEY",
          "XAI_API_KEY",
          "DEEPSEEK_API_KEY"
        ],
        "notes": "Routing providers require separate credentials; the funded router server is opt-in.",
        "port": 8402,
        "health": "/health"
      }
    },
    {
      "id": "leviathan",
      "path": "leviathan",
      "category": "core",
      "purpose": "Runtime CLI and memory/orchestration loop",
